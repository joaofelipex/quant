/////////////////////////////////////
// WINTRENDBOT WDO - EMA + MACD    //
// com stop/alvo e SEM piramide    //
/////////////////////////////////////
{ BUG CORRIGIDO: a versao original comprava/vendia de novo }
{ toda vez que cenarioCompra/cenarioVenda ficava verdadeiro,}
{ mesmo ja estando posicionado no mesmo lado - a posicao    }
{ ia crescendo sem parar. Agora so entra se PosicaoZerada.  }

parâmetro
EmaRapida(9);
EmaLenta(21);
PontosStop(8);
PontosAlvo(16);
HoraIni(915);
HoraFecha(1750);

var
sEmaRapida     : Real;
sEmaLenta      : Real;
sPrevEmaRapida : Real;
sPrevEmaLenta  : Real;
mcd            : Real;
me             : Real;
tendeAlta      : booleano;
tendeBaixa     : booleano;
cenarioCompra  : booleano;
cenarioVenda   : booleano;
posicaoZerada  : booleano;
precoStop      : Real;
precoAlvo      : Real;

begin

sEmaRapida :=
  mediaexp(EmaRapida,
    Fechamento);

sEmaLenta :=
  mediaexp(EmaLenta,
    Fechamento);

sPrevEmaRapida :=
  sEmaRapida[1];

sPrevEmaLenta :=
  sEmaLenta[1];

mcd := macd(26,12,9);

me := mediaexp(9, mcd);

tendeAlta :=
  (sPrevEmaRapida <
   sPrevEmaLenta)
  e
  (sEmaRapida >
   sEmaLenta)
  e
  (mcd > me);

tendeBaixa :=
  (sPrevEmaRapida >
   sPrevEmaLenta)
  e
  (sEmaRapida <
   sEmaLenta)
  e
  (mcd < me);

cenarioCompra :=
  tendeAlta;

cenarioVenda :=
  tendeBaixa;

posicaoZerada :=
  (BuyPosition = 0)
  e
  (SellPosition = 0);

Begin

{ saidas: COMPRADO fecha com SellToCover, VENDIDO com BuyToCover }
Se (BuyPosition > 0)
e
((Fechamento <= precoStop)
 ou (Fechamento >= precoAlvo)
 ou (Time >= HoraFecha))
então
SellToCoverAtMarket;

Se (SellPosition > 0)
e
((Fechamento >= precoStop)
 ou (Fechamento <= precoAlvo)
 ou (Time >= HoraFecha))
então
BuyToCoverAtMarket;

Se (posicaoZerada)
e
(Time >= HoraIni)
e
(Time < HoraFecha)
então

inicio

se cenarioCompra então

inicio
precoStop := Fechamento - PontosStop;
precoAlvo := Fechamento + PontosAlvo;
paintbar(clgreen);
BuyAtMarket;
fim

senão se cenarioVenda
então

inicio
precoStop := Fechamento + PontosStop;
precoAlvo := Fechamento - PontosAlvo;
paintbar(clred);
SellShortAtMarket;
fim;

fim;

end;
end.
