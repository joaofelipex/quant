# copie para /etc/quant-portfolio.env (chmod 600). NUNCA versionar o arquivo real.
# O paper da carteira so usa dados PUBLICOS: nao ha chave de corretora aqui, e nao deve haver.
# (as chaves, se um dia existirem, ficam em /etc/quant-live.env e so o quant-live.service as le)
QUANT_PORT_STATE=/var/lib/quant/portfolio_state.json
QUANT_PORT_LOG=/var/lib/quant/portfolio_log.csv
QUANT_SITE_DIR=/var/www/quant
# alertas por Telegram (opcional; deixe vazio para so logar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
