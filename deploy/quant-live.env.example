# copie para /etc/quant-live.env (chmod 600). NUNCA versionar o arquivo real.
QUANT_MODE=paper
# paper | testnet | live
QUANT_SYMBOL=ETH/USDT:USDT
# fonte das barras: auto = paper le o endpoint publico de spot (sem chave, alcanca de qualquer regiao);
# testnet/live leem a exchange via ccxt. Para forcar:  public | ccxt
# QUANT_FEED=auto
QUANT_TIMEFRAME=5m
QUANT_QTY=0.01
# perda diaria maxima, na moeda da conta (USDT)
QUANT_MAX_DAILY_LOSS=20
QUANT_STOP_ATR=2.0
QUANT_STATE=/var/lib/quant/live_state.json
QUANT_KILL_FILE=/var/lib/quant/KILL
# ambiente de teste (so vale com QUANT_MODE=testnet):
#   testnet = sandbox legado de futuros (testnet.binancefuture.com); responde tambem de IPs dos EUA
#   demo    = Demo Trading (demo-fapi.binance.com); devolve 451 em IPs dos EUA
# as chaves de um NAO valem no outro. Preencha as chaves com:  sudo bash deploy/definir-chaves.sh
QUANT_TESTNET_KIND=testnet
# so para testnet/live:
BINANCE_API_KEY=
BINANCE_API_SECRET=
# QUANT_ALLOW_MAINNET=yes-i-know   (so com estrategia aprovada pela regra do repo)
