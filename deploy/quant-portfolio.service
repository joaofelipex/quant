[Unit]
Description=quant portfolio paper (tsmom_cripto), um disparo por dia
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/etc/quant-live.env
Environment=QUANT_PORT_STATE=/var/lib/quant/portfolio_state.json
Environment=QUANT_PORT_LOG=/var/lib/quant/portfolio_log.csv
ExecStart=/opt/quant/.venv/bin/python -m quant.live.portfolio
