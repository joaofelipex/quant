[Unit]
Description=quant portfolio paper (tsmom_cripto), um disparo por dia
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
# so dados publicos: este servico NUNCA le /etc/quant-live.env (la ficam as chaves da corretora)
EnvironmentFile=/etc/quant-portfolio.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/quant/.venv/bin/python -m quant.live.portfolio
ExecStartPost=/opt/quant/.venv/bin/python -m quant.dashboard

# privilegio minimo: so escreve em /var/lib/quant (criado pelo systemd) e no diretorio do painel
StateDirectory=quant
ReadWritePaths=/var/www/quant
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
